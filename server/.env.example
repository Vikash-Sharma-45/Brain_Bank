# ──────────────────────────────────────────────
# BrainBank – Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studynotes?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Supabase Storage
SUPABASE_URL=
# Secret: server only. Never expose this key to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=notes-files

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Admin seed credentials
ADMIN_EMAIL=admin@studynotes.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Admin
