# ──────────────────────────────────────────────
# BrainBank – Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studynotes?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=studynotes
R2_PUBLIC_URL=                          # leave blank if bucket is private-only

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Admin seed credentials
ADMIN_EMAIL=admin@studynotes.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Admin
